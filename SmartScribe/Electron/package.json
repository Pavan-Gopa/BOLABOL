{
  "name": "smartscribe-app",
  "version": "1.3.0",
  "description": "Effortless dictation. Local Whisper.cpp (Vulkan/Metal/CPU) with clean Electron UI.",
  "main": "main.js",
  "author": "YourName",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/ensure-vulkan-addon.js && npm run compile && npm run vite-build && electron .",
    "compile": "tsc",
    "vite-build": "vite build",
    "build": "npm run compile && npm run vite-build && electron-builder --win",
    "build:x64": "npm run compile && npm run vite-build && electron-builder --win --x64",
    "build:arm64": "npm run compile && npm run vite-build && electron-builder --win --arm64",
    "build:mac": "node scripts/require-vulkan-sdk.js && npm run rebuild:cpu-addon:darwin-x64 && npm run build:vulkan-addon:required && npm run compile && npm run vite-build && electron-builder --mac --x64",
    "build:mac:arm64": "npm run rebuild:cpu-addon:darwin-arm64 && npm run compile && npm run vite-build && npm run fix-whisper && npm run clear:vulkan-addon && SMARTSCRIBE_SKIP_VULKAN_BUNDLE=1 electron-builder --mac --arm64",
    "build:linux": "npm run compile && npm run vite-build && electron-builder --linux",
    "pack": "npm run compile && npm run vite-build && electron-builder --dir",
    "rebuild": "electron-rebuild -f -w @kutalia/whisper-node-addon",
    "rebuild:cpu-addon:darwin-x64": "electron-rebuild -f -w @kutalia/whisper-node-addon --arch=x64 --platform=darwin",
    "rebuild:cpu-addon:darwin-arm64": "electron-rebuild -f -w @kutalia/whisper-node-addon --arch=arm64 --platform=darwin",
    "fix-whisper": "node scripts/fix-whisper-paths.js",
    "clear:vulkan-addon": "node scripts/clear-vulkan-addon.js",
    "build:vulkan-addon": "npm --prefix native/whisper-vulkan-addon run build || echo 'Skipped Vulkan addon build (optional)'",
    "build:vulkan-addon:required": "npm --prefix native/whisper-vulkan-addon run build",
    "rebuild:vulkan-addon:required": "npm --prefix native/whisper-vulkan-addon run rebuild",
    "postinstall": "electron-rebuild -f -w @kutalia/whisper-node-addon && npm run fix-whisper"
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "@kutalia/whisper-node-addon": "^1.1.0",
    "electron-log": "^5.1.5",
    "ffmpeg-static": "^5.2.0",
    "marked": "^16.1.2",
    "onnxruntime-node": "^1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cmake-js": "^7.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.example.smartscribe",
    "productName": "SmartScribe",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "transcription.fork.js",
      "parakeet.worker.js",
      "package.json",
      "node_modules/ffmpeg-static/**",
      {
        "from": "native/whisper-vulkan-addon/build/Release",
        "to": "native/whisper-vulkan-addon/build/Release",
        "filter": [
          "**/*"
        ]
      },
      "audio-recorder-worklet.js"
    ],
    "extraFiles": [
      {
        "from": "native/whisper-vulkan-addon/build/Release/",
        "to": "Frameworks/",
        "filter": [
          "libwhisper*.dylib",
          "libggml*.dylib",
          "libvulkan*.dylib",
          "libMoltenVK*.dylib",
          "MoltenVK_icd.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "node_modules/@kutalia/whisper-node-addon/dist/mac-arm64",
        "to": "Frameworks/mac-arm64"
      },
      {
        "from": "node_modules/@kutalia/whisper-node-addon/dist/darwin-arm64",
        "to": "Frameworks/darwin-arm64"
      }
    ],
    "asarUnpack": [
      "native/whisper-vulkan-addon/build/Release/**",
      "node_modules/@kutalia/whisper-node-addon/dist/**",
      "**/*.node",
      "**/*.dylib",
      "**/*.so*",
      "**/*.dll",
      "**/*.metallib",
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SmartScribe needs microphone access to transcribe your speech locally."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons"
    },
    "afterPack": "scripts/after-pack-verify-vulkan.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": []
}
